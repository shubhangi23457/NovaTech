# Base URL of the product API (DummyJSON is a free, read-only demo API with no key).
VITE_API_BASE_URL=https://dummyjson.com

# DummyJSON prices are in USD; NovaTech shows INR. Display price = round(USD * rate).
VITE_USD_TO_INR=83

# Mock-auth latency in ms (simulates a network call). Set 0 to disable.
VITE_MOCK_AUTH_DELAY=500

# Never put secrets here: every VITE_* variable is bundled into public JavaScript.
